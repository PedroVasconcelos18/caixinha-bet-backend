# Configuração do banco — copie para .env e ajuste se necessário.
# O .env NUNCA é versionado (está no .gitignore). Sem segredos reais aqui.
#
# Estas variáveis são consumidas por:
#   - docker-compose.yml (sobe o Postgres local)
#   - application.yml (a aplicação conecta no Postgres, lida via spring-dotenv)
#
# spring-dotenv lê este .env automaticamente no boot do Spring. Sintaxe dotenv
# padrão: '$VAR' / '${VAR}' = interpolação; use '\$' para um '$' literal
# (necessário p/ a API key do Asaas, que começa com '$aact_hmlg_').

DB_HOST=localhost
DB_PORT=5432
DB_NAME=caixinhabet
DB_USER=caixinhabet
DB_PASSWORD=caixinhabet

# URL pública do FRONT (Story 2.1).
# O magic link enviado por e-mail aponta para este host + /auth/callback.
# Em dev: http://localhost:3000 (Next.js). Em produção: domínio público HTTPS.
# NÃO é segredo — só convenção de ambiente.
APP_PUBLIC_BASE_URL=http://localhost:3000

# E-mail (Story 2.4; provedor Resend, decisão 2026-05-23).
#
# Por padrão TODOS os senders ficam em "log" — o backend só LOGA a URL/
# mensagem no console, sem mandar nada por SMTP. Para enviar de verdade:
#   1. Crie uma API key em https://resend.com → API Keys.
#   2. Preencha SMTP_PASSWORD abaixo com a key (formato re_xxx).
#   3. Troque o(s) *_SENDER que você quer testar para "smtp".
#   4. Enquanto caixinha.bet não estiver verificado no painel do Resend,
#      use EMAIL_FROM=onboarding@resend.dev — esse remetente sandbox
#      do Resend só ENTREGA para o e-mail do dono da conta (limitação
#      do plano free + domínio não verificado).
#
# Para tirar do sandbox (produção): no painel resend.com, adicionar o
# domínio caixinha.bet, configurar SPF + DKIM + Return-Path no DNS,
# aguardar verificação, e voltar EMAIL_FROM para caixinha@caixinha.bet.
# Este step é manual do Pedro — não tem como automatizar.
#
# Defaults do application.yml: SMTP_HOST=smtp.resend.com, SMTP_PORT=465,
# SMTP_USER=resend. Não precisa setar essas três aqui se for usar Resend.

AUTH_MAGIC_LINK_SENDER=log
CAIXINHA_CONVITE_SENDER=log
CAIXINHA_MINIMO_ATINGIDO_SENDER=log
CAIXINHA_FORMACAO_SENDER=log
CAIXINHA_PREMIO_GANHO_SENDER=log
CAIXINHA_CANCELAMENTO_SENDER=log

# Em sandbox use onboarding@resend.dev (só entrega para o dono da conta).
# Em produção (após verificar caixinha.bet): caixinha@caixinha.bet.
EMAIL_FROM=caixinha@caixinha.bet

# Resend SMTP relay — só preencher SMTP_PASSWORD; os demais têm default
# correto no application.yml.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
SMTP_PASSWORD=

# Asaas — sandbox por default. Nunca commitar tokens reais.
# Base URL confirmada com chave de homologação real (Pedro, 2026-05-19):
#   https://sandbox.asaas.com/api/v3   (NOTE: já inclui /api/v3)
# Painel web (criar conta, simular pagamento, gerar API key) fica em
# https://sandbox.asaas.com — mesma raiz, sem /api/v3.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
#
# API key gerada no painel sandbox.asaas.com → Integrações.
# Asaas chama isso de "API Key" no painel; aqui ASAAS_ACCESS_TOKEN
# (nome do código), valor vai no header `access_token`.
# ATENÇÃO: a key real começa com '$' (ex.: $aact_hmlg_...). No .env real,
# escape com '\$' para o spring-dotenv não tratar como interpolação:
#   ASAAS_ACCESS_TOKEN=\$aact_hmlg_xxxxx
ASAAS_ACCESS_TOKEN=
#
# Shared secret do webhook — Asaas chama de "Webhook Secret"/"authToken";
# aqui ASAAS_WEBHOOK_AUTH_TOKEN (nome do código), validado no header
# `asaas-access-token` de cada webhook entrante.
ASAAS_WEBHOOK_AUTH_TOKEN=
#
# ID de customer de teste (POST /api/v3/customers uma vez). Necessário
# para AsaasSandboxTest porque API exige customer no payload de cobrança.
# Como criar: ver gate-asaas-2026-05.md (seção "Pré-rodada do smoke").
ASAAS_TEST_CUSTOMER_ID=
