# Configuração do banco — copie para .env e ajuste se necessário.
# O .env NUNCA é versionado (está no .gitignore). Sem segredos reais aqui.
#
# Estas variáveis são consumidas por:
#   - docker-compose.yml (sobe o Postgres local)
#   - application.yml (a aplicação conecta no Postgres, lida via spring-dotenv)
#
# spring-dotenv lê este .env automaticamente no boot do Spring. Sintaxe dotenv
# padrão: '$VAR' / '${VAR}' = interpolação; use '\$' para um '$' literal
# (necessário p/ a API key do Asaas, que começa com '$aact_hmlg_').

DB_HOST=localhost
DB_PORT=5432
DB_NAME=caixinhabet
DB_USER=caixinhabet
DB_PASSWORD=caixinhabet

# URL pública do FRONT (Story 2.1).
# O magic link enviado por e-mail aponta para este host + /auth/callback.
# Em dev: http://localhost:3000 (Next.js). Em produção: domínio público HTTPS
# do FRONT, ex.: https://www.caixinhabet.com — SEM barra no final (o código
# concatena /auth/callback; barra extra geraria //auth/callback).
# Se não setar em prod, o link sai apontando para localhost:3000.
# NÃO é segredo — só convenção de ambiente.
APP_PUBLIC_BASE_URL=http://localhost:3000

# CORS — origens do FRONT permitidas a chamar a API com cookie (CSV).
# allowCredentials=true exige listar a origem exata (NUNCA "*").
# Dev: http://localhost:3000. Prod: a(s) URL(s) do front, ex.:
# https://www.caixinhabet.com (sem path, sem barra final).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie de sessão.
# Dev (mesma origem): Lax + secure=false + domain vazio.
#
# PROD recomendado — API em SUBDOMÍNIO do mesmo apex que o front
# (www.caixinhabet.com  x  api.caixinhabet.com):
#   AUTH_COOKIE_DOMAIN=.caixinhabet.com   (compartilha o cookie entre os dois;
#                                          o middleware do front passa a vê-lo)
#   AUTH_COOKIE_SECURE=true               (HTTPS)
#   AUTH_COOKIE_SAME_SITE=Lax             (mesmo apex = same-site; Lax basta)
# Sem o domain compartilhado, o cookie fica host-only no domínio da API e o
# login "pisca e volta" (o front nunca enxerga o cookie).
#
# Secure é explícito (não isSecure()) porque o proxy TLS do Railway entrega a
# request como HTTP ao container. Se um dia front e API ficarem em apex
# DIFERENTES (sem subdomínio comum), aí sim: SameSite=None + Secure=true e
# proteção de rota no client (cookie não cruza apex distintos).
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# E-mail (Story 2.4). Em dev local: sender=log (não envia, só loga).
# Cada *_SENDER aceita: log | smtp | resend.
#
# >>> PRODUÇÃO em Railway/Render/Fly: use 'resend' (API HTTP, porta 443).
#     Esses PaaS BLOQUEIAM SMTP de saída (25/465/587) → "Connection timed out".
#     Basta:  *_SENDER=resend  +  RESEND_API_KEY=re_xxx  +  EMAIL_FROM=...
#     (não precisa de SMTP_* nesse caminho).
#
# Caminho SMTP (dev/hosts sem bloqueio): sender=smtp + SMTP_* abaixo.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465            (SSL implícito — default; 587 costuma ser bloqueada)
#   SMTP_USER=resend         (literal, igual para todo mundo)
#   SMTP_PASSWORD=re_xxx     (API key gerada em resend.com/api-keys)
#   (Para forçar 587+STARTTLS: SMTP_PORT=587 SMTP_SSL=false SMTP_STARTTLS=true)
#
# EMAIL_FROM precisa estar em DOMÍNIO VERIFICADO no Resend (resend.com/domains),
# senão o envio é rejeitado. CaixinhaBootGuard/AuthBootGuard barram o boot se
# um sender ficar em 'log' fora de dev.
AUTH_MAGIC_LINK_SENDER=log
CAIXINHA_CONVITE_SENDER=log
CAIXINHA_MINIMO_ATINGIDO_SENDER=log
CAIXINHA_FORMACAO_SENDER=log
CAIXINHA_PREMIO_GANHO_SENDER=log
CAIXINHA_CANCELAMENTO_SENDER=log
EMAIL_FROM=noreply@caixinhabet.com
# API HTTP (caminho recomendado em prod):
RESEND_API_KEY=
# SMTP (caminho alternativo):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Asaas — sandbox por default. Nunca commitar tokens reais.
# Base URL confirmada com chave de homologação real (Pedro, 2026-05-19):
#   https://sandbox.asaas.com/api/v3   (NOTE: já inclui /api/v3)
# Painel web (criar conta, simular pagamento, gerar API key) fica em
# https://sandbox.asaas.com — mesma raiz, sem /api/v3.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
#
# API key gerada no painel sandbox.asaas.com → Integrações.
# Asaas chama isso de "API Key" no painel; aqui ASAAS_ACCESS_TOKEN
# (nome do código), valor vai no header `access_token`.
# ATENÇÃO: a key real começa com '$' (ex.: $aact_hmlg_...). No .env real,
# escape com '\$' para o spring-dotenv não tratar como interpolação:
#   ASAAS_ACCESS_TOKEN=\$aact_hmlg_xxxxx
ASAAS_ACCESS_TOKEN=
#
# Shared secret do webhook — Asaas chama de "Webhook Secret"/"authToken";
# aqui ASAAS_WEBHOOK_AUTH_TOKEN (nome do código), validado no header
# `asaas-access-token` de cada webhook entrante.
ASAAS_WEBHOOK_AUTH_TOKEN=
#
# ID de customer de teste (POST /api/v3/customers uma vez). Necessário
# para AsaasSandboxTest porque API exige customer no payload de cobrança.
# Como criar: ver gate-asaas-2026-05.md (seção "Pré-rodada do smoke").
ASAAS_TEST_CUSTOMER_ID=
