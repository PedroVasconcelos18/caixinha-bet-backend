# Configuração do banco — copie para .env e ajuste se necessário.
# O .env NUNCA é versionado (está no .gitignore). Sem segredos reais aqui.
#
# Estas variáveis são consumidas por:
#   - docker-compose.yml (sobe o Postgres local)
#   - application.yml (a aplicação conecta no Postgres)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=caixinhabet
DB_USER=caixinhabet
DB_PASSWORD=caixinhabet

# URL pública do FRONT (Story 2.1).
# O magic link enviado por e-mail aponta para este host + /auth/callback.
# Em dev: http://localhost:3000 (Next.js). Em produção: domínio público HTTPS.
# NÃO é segredo — só convenção de ambiente.
APP_PUBLIC_BASE_URL=http://localhost:3000

# E-mail (Story 2.4). Em dev local: sender=log (não envia, só loga).
# Em produção: sender=smtp + SMTP_* configurados. Provedores típicos:
# SendGrid, Mailgun, AWS SES — Pedro decide na hora do deploy.
AUTH_MAGIC_LINK_SENDER=log
CAIXINHA_CONVITE_SENDER=log
EMAIL_FROM=caixinha@caixinha.bet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Asaas — sandbox por default. Nunca commitar tokens reais.
# Base URL confirmada com chave de homologação real (Pedro, 2026-05-19):
#   https://sandbox.asaas.com/api/v3   (NOTE: já inclui /api/v3)
# Painel web (criar conta, simular pagamento, gerar API key) fica em
# https://sandbox.asaas.com — mesma raiz, sem /api/v3.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
#
# API key gerada no painel sandbox.asaas.com → Integrações.
# Asaas chama isso de "API Key" no painel; aqui ASAAS_ACCESS_TOKEN
# (nome do código), valor vai no header `access_token`.
ASAAS_ACCESS_TOKEN=
#
# Shared secret do webhook — Asaas chama de "Webhook Secret"/"authToken";
# aqui ASAAS_WEBHOOK_AUTH_TOKEN (nome do código), validado no header
# `asaas-access-token` de cada webhook entrante.
ASAAS_WEBHOOK_AUTH_TOKEN=
#
# ID de customer de teste (POST /api/v3/customers uma vez). Necessário
# para AsaasSandboxTest porque API exige customer no payload de cobrança.
# Como criar: ver gate-asaas-2026-05.md (seção "Pré-rodada do smoke").
ASAAS_TEST_CUSTOMER_ID=
